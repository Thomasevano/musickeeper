{
  "extends": "@adonisjs/tsconfig/tsconfig.client.json",
  "compilerOptions": {
    "module": "ESNext",
    "paths": {
      "~/*": ["./*"],
      "$lib/*": ["./lib/*"],
      "$components/*": ["./components/*"],
      "$helpers/*": ["./lib/helpers/*"]
    },
    "types": ["vite/client", "vite-plugin-pwa/client"]
  },
  "include": ["./**/*.ts", "./**/*.svelte"]
}
