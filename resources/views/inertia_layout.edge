<!DOCTYPE html>
<html lang="en">

  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    <title>
      {{ title }}
    </title>
    <meta name="description" content="{{ description }}" />
    <meta name="theme-color" content="#ffffff" />
    @if(page.component === 'home')
      <link rel="preload" href="/landing/fonts/font-05.woff2" as="font" type="font/woff2" crossorigin />
      <link rel="preload" href="/landing/fonts/font-12.woff2" as="font" type="font/woff2" crossorigin />
    @end

    {{-- Favicon --}}
    <link rel="icon" href="/musickeeper.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-180x180.png" />

    {{-- PWA Manifest --}}
    <link rel="manifest" href="/manifest.webmanifest" />

    @vite(['inertia/app.ts', `inertia/pages/${page.component}.svelte`])
    @inertiaHead()
  </head>

  <body class="font-sans">
    @inertia()
  </body>

</html>
